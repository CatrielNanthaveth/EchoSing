# Copy to backend/.env and adjust. Values match docker-compose.yml.
ECHOSING_DATABASE_URL=postgresql+asyncpg://echosing:echosing@localhost:5433/echosing
ECHOSING_REDIS_URL=redis://localhost:6379/0
ECHOSING_HEALTH_CHECK_TIMEOUT_S=2.0
# Relative paths are resolved from the working directory (backend/).
ECHOSING_STORAGE_ROOT=storage
ECHOSING_MAX_UPLOAD_BYTES=52428800
# Required for /admin endpoints (sent as X-Admin-Token). Unset = admin disabled.
# Generate one with: python -c "import secrets; print(secrets.token_hex(32))"
# ECHOSING_ADMIN_TOKEN=
